generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TEACHER
}

enum Level {
  PRIMARY_5
  PRIMARY_6
  PREP_1
  PREP_2
  PREP_3
  SEC_1
  SEC_2
  SEC_3
}

enum ContentType {
  AR
  EN
  CODE
}

enum CodeLanguage {
  PYTHON
  JAVASCRIPT
}

model User {
  id             String   @id @default(uuid())
  fullName       String   @map("full_name")
  email          String   @unique
  passwordHash   String   @map("password_hash")
  phone          String
  parentPhone    String?  @map("parent_phone")
  level          Level?
  role           Role     @default(STUDENT)
  avatarInitials String   @map("avatar_initials")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  teacherProfile TeacherProfile?
  refreshTokens  RefreshToken[]
  enrollments    Enrollment[]
  quizAttempts   QuizAttempt[]
  teacherReviews TeacherReview[]
  platformReview PlatformReview?

  @@map("users")
}

model Subject {
  id          String @id @default(uuid())
  name        String
  icon        String
  description String
  color       String

  teachers TeacherProfile[]
  courses  Course[]

  @@map("subjects")
}

model TeacherProfile {
  id                String   @id @default(uuid())
  userId            String   @unique @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug              String   @unique
  title             String
  subjectId         String   @map("subject_id")
  subject           Subject  @relation(fields: [subjectId], references: [id])
  yearsExperience   Int      @default(0) @map("years_experience")
  about             String
  credentials       String[]
  ratingCache       Float    @default(0) @map("rating_cache")
  reviewCountCache  Int      @default(0) @map("review_count_cache")
  studentCountCache Int      @default(0) @map("student_count_cache")
  createdAt         DateTime @default(now()) @map("created_at")

  courses Course[]
  reviews TeacherReview[]

  @@map("teacher_profiles")
}

model Course {
  id                String   @id @default(uuid())
  slug              String   @unique
  title             String
  description       String
  subjectId         String   @map("subject_id")
  subject           Subject  @relation(fields: [subjectId], references: [id])
  teacherId         String   @map("teacher_id")
  teacher           TeacherProfile @relation(fields: [teacherId], references: [id])
  level             Level
  price             Int      @default(0)
  ratingCache       Float    @default(0) @map("rating_cache")
  studentCountCache Int      @default(0) @map("student_count_cache")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  lessons     Lesson[]
  enrollments Enrollment[]

  @@map("courses")
}

model Lesson {
  id                  String   @id @default(uuid())
  courseId            String   @map("course_id")
  course              Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title               String
  order               Int
  duration            String
  isFree              Boolean  @default(false) @map("is_free")
  description         String
  videoId             String   @map("video_id")
  hasPdf              Boolean  @default(false) @map("has_pdf")
  pdfUrl              String?  @map("pdf_url")
  pdfPages            Int?     @map("pdf_pages")
  hasQuiz             Boolean  @default(false) @map("has_quiz")
  quizDurationSeconds Int?     @map("quiz_duration_seconds")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  quizQuestions QuizQuestion[]
  quizAttempts  QuizAttempt[]

  @@unique([courseId, order])
  @@map("lessons")
}

model QuizQuestion {
  id           String        @id @default(uuid())
  lessonId     String        @map("lesson_id")
  lesson       Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  question     String
  imageUrl     String?       @map("image_url")
  contentType  ContentType   @default(AR) @map("content_type")
  codeLanguage CodeLanguage? @map("code_language")
  correctIndex Int           @map("correct_index")
  order        Int

  options QuizOption[]

  @@map("quiz_questions")
}

model QuizOption {
  id         String       @id @default(uuid())
  questionId String       @map("question_id")
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String?
  imageUrl   String?      @map("image_url")
  order      Int

  @@map("quiz_options")
}

model Enrollment {
  id                 String   @id @default(uuid())
  userId             String   @map("user_id")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId           String   @map("course_id")
  course             Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress           Int      @default(0)
  completedLessonIds String[] @default([]) @map("completed_lesson_ids")
  enrolledAt         DateTime @default(now()) @map("enrolled_at")

  @@unique([userId, courseId])
  @@map("enrollments")
}

model QuizAttempt {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId       String   @map("lesson_id")
  lesson         Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  score          Int
  correctCount   Int      @map("correct_count")
  totalQuestions Int      @map("total_questions")
  answers        Json
  timedOut       Boolean  @default(false) @map("timed_out")
  completedAt    DateTime @default(now()) @map("completed_at")

  @@map("quiz_attempts")
}

model TeacherReview {
  id         String         @id @default(uuid())
  teacherId  String         @map("teacher_id")
  teacher    TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  studentId  String         @map("student_id")
  student    User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String?
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  @@unique([teacherId, studentId])
  @@map("teacher_reviews")
}

model PlatformReview {
  id        String   @id @default(uuid())
  studentId String   @unique @map("student_id")
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_reviews")
}

model RefreshToken {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  replacedByHash String?   @map("replaced_by_hash")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("refresh_tokens")
}
